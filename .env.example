# Copy this file to .env.local and fill it in. start.bat does the copy for you the first time.
# .env.local stays on your computer: it is never committed or shared.
# Restart the app after changing anything here.

# Google sign-in. From Google Cloud Console > Google Auth Platform > Clients (a "Web application"
# client). Its Authorized redirect URI must be http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Ads API developer token. From Google Ads (manager account) > Tools > API Center.
GOOGLE_ADS_DEVELOPER_TOKEN=

# The "Ask about your marketing" chat box. Create a key at console.anthropic.com > API keys.
# Each question is billed to that Anthropic account (usually a few cents; long reports cost more).
ANTHROPIC_API_KEY=

# Who may sign in: email addresses and/or whole domains, separated by commas.
# "@twinhomebuyer.com" lets in everyone with a twinhomebuyer.com email. To add someone outside
# the company, add their address: ALLOWED_EMAILS=@twinhomebuyer.com,partner@gmail.com
ALLOWED_EMAILS=@twinhomebuyer.com

# Only needed once the app is deployed to a website:
# SITE_URL=https://marketing.example.com
# AUTH_SECRET=a-long-random-string    (locally one is created for you in .data/)

# Optional: Google Ads API version (defaults to v25).
# GOOGLE_ADS_API_VERSION=v25
